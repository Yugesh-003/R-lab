# BARCHART
# Load data from CSV
data <- read.csv("datasets/business_data.csv")
# BARCHART
# Load data from CSV
data <- read.csv("datasets/business_data.csv")
# BARCHART
# Load data from CSV
data <- read.csv("business_data.csv")
View(data)
# Create a bar chart
counts <- table(data$Region)
barplot(counts,
main = "Bar chart of Regional counts of Sales",
xlab = "Regions",
ylab = "Frequency",
col = "blue",
border = "black")
# BOXPLOT
# Load data from CSV
data <- read.csv("datasets/business_data.csv")
# BOXPLOT
# Load data from CSV
data <- read.csv("business_data.csv")
# Create a boxplot
boxplot(Sales ~ Region,
data = data,
main = "Boxplot of Sales by Regions",
xlab = "Region",
ylab = "Sales",
col = "lightblue",
border = "black")
# HEATMAP
# Load data from CSV
data <- read.csv("business_data.csv")
numeric_data <- data[, c("Sales", "Profit", "Expenses", "Customers")]
heatmap(as.matrix(numeric_data))
# HISTOGRAM
# Load data from CSV
data <- read.csv("business_data.csv")
View(data)
v_data <- as.vector(as.matrix(data[, 2:5]))
hist(v_data,
main = "Histogram of Data Values",
xlab = "Values",
ylab = "Frequency",
col = "lightblue",
border = "black")
# LINECHART
# Load data from CSV
data <- read.csv("datasets/business_data.csv")
# LINECHART
# Load data from CSV
data <- read.csv("business_data.csv")
x <- data$Years
y <- data$Sales
# Create a line chart
plot(x, y,
type = "l",
main = "Operating performance",
xlab = "Years",
ylab = "Sales",
col = "blue")
# SCATTER PLOT
# Load data from CSV
data <- read.csv("datasets/business_data.csv")
# SCATTER PLOT
# Load data from CSV
data <- read.csv("business_data.csv")
# Scatter plot
plot(data$Years, data$Sales,
main = "Scatter plot of sales over the years",
xlab = "Years",
ylab = "Sales",
col = "blue")
