install.packages("readxl")
data <- read_excel("BDA.xlsx",sheet=4,range="A1:I19")
View(data)
#create a bar chart
counts<-table(data$Region)
barplot(counts,main="Bar chart of Regional counts of Sales",
xlab="Regions",ylab ="Frequency",
col="blue",border="black")
# BARCHART
# Create dataframe
data <- data.frame(
Years = c(2015, 2016, 2017, 2018, 2019),
Sales = c(100, 150, 200, 180, 250),
Profit = c(20, 30, 50, 40, 60),
Expenses = c(80, 120, 150, 140, 190),
Customers = c(200, 240, 300, 280, 350),
Region = c("North", "South", "East", "West", "North")
)
View(data)
# Create a bar chart
counts <- table(data$Region)
barplot(counts,
main = "Bar chart of Regional counts of Sales",
xlab = "Regions",
ylab = "Frequency",
col = "blue",
border = "black")
# BOXPLOT
# Create dataframe
data <- data.frame(
Years = c(2015, 2016, 2017, 2018, 2019),
Sales = c(100, 150, 200, 180, 250),
Profit = c(20, 30, 50, 40, 60),
Expenses = c(80, 120, 150, 140, 190),
Customers = c(200, 240, 300, 280, 350),
Region = c("North", "South", "East", "West", "North")
)
# Create a boxplot
boxplot(Sales ~ Region,
data = data,
main = "Boxplot of Sales by Regions",
xlab = "Region",
ylab = "Sales",
col = "lightblue",
border = "black")
